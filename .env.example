# ─────────────────────────────────────────────────────────────────────────────
# SunoSathi — Required Environment Variables
#
# Copy this file to .env and fill in the values.
# NEVER commit .env or any file containing real secrets to version control.
#
# In Replit: set all values via the "Secrets" panel (not .env files).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection URL — provisioned automatically by Replit Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Session ───────────────────────────────────────────────────────────────────
# A long, random secret used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-session-secret-here

# ── Replit Environment (set automatically by Replit) ─────────────────────────
# Comma-separated list of public domains for this Repl.
# Used to build the strict CORS origin whitelist.
REPLIT_DOMAINS=your-repl-name.username.repl.co

# ── Node Environment ──────────────────────────────────────────────────────────
# Set to "production" in deployed environments.
# Controls HSTS headers, log levels, and other environment-specific behaviour.
NODE_ENV=development

# ── Application Port ──────────────────────────────────────────────────────────
# Injected by Replit per-artifact. Do not set this manually.
PORT=8080
